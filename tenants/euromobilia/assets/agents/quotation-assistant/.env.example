# ============================================================
# Euromobilia Quotation Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to Git.
# ============================================================

# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── LLM Provider ─────────────────────────────────────────────
# Option A: OpenAI direct (unlimited, no credit cap)
# OPENAI_API_KEY=
# Option B: OpenRouter (supports free-fallback tiers)
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o

# ─── LangSmith Tracing ────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=euromobilia-quotation
LANGCHAIN_TRACING_V2=true

# ─── Tavily (Web Search) ──────────────────────────────────────
TAVILY_API_KEY=

# ─── Image Generation ─────────────────────────────────────────
IMAGE_GEN_PROVIDER=pollinations
REPLICATE_API_TOKEN=

# ─── Kapso (WhatsApp Business API) ────────────────────────────
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# ─── Bitrix24 / Slack ─────────────────────────────────────────
# NOTE: Can be handled via Composio connections instead.
BITRIX24_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ─── Composio (Tool Orchestration) ────────────────────────────
COMPOSIO_API_KEY=

# ─── FAISS Vector Store ───────────────────────────────────────
FAISS_INDEX_DIR=./.data/faiss_index
