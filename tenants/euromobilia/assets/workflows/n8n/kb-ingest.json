{
  "name": "KB Ingest",
  "nodes": [
    {
      "id": "schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{
            "field": "hours",
            "hoursInterval": 24
          }]
        }
      }
    },
    {
      "id": "fetch",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "parameters": {
        "method": "GET",
        "url": "https://your-catalog-api.com/products"
      }
    },
    {
      "id": "embed",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "https://your-embedding-api.com/embed"
      }
    }
  ],
  "connections": {
    "schedule": {
      "main": [[{"node": "fetch", "type": "main", "index": 0}]]
    },
    "fetch": {
      "main": [[{"node": "embed", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
