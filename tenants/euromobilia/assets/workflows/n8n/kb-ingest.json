{
  "name": "KB Ingest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/agent/invoke",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "phone_number": "__system__",
          "conversation_id": "__kb_sync__",
          "message": "__sync_kb__"
        },
        "options": {}
      },
      "id": "trigger-sync",
      "name": "Trigger KB Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nreturn [{\n  json: {\n    status: resp.reply_text ? 'success' : 'failed',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "log-result",
      "name": "Log Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KAPSO_BASE_URL }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.KAPSO_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "phone_number": "={{ $env.ADMIN_PHONE_NUMBER }}",
          "message_type": "text",
          "text": "=KB Sync: {{ $json.status }} at {{ $json.timestamp }}"
        },
        "options": {}
      },
      "id": "kapso-notify",
      "name": "Kapso WhatsApp Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Trigger KB Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger KB Sync": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Result": {
      "main": [
        [
          {
            "node": "Kapso WhatsApp Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": ["euromobilia", "kb-sync", "kitchen-quotation", "mcp"],
  "staticData": null
}
