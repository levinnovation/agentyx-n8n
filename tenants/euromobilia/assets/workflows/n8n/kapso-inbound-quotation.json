{
  "name": "Kapso Inbound Quotation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kapso-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "kapso-webhook",
      "name": "Kapso Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "kapso-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Normalize Kapso payload to agent format\nconst body = $input.first().json.body;\nreturn [{\n  json: {\n    phone_number: body.phone_number || body.phone,\n    conversation_id: body.phone_number || body.phone,\n    message: body.text || body.caption || '',\n    contact_name: body.contact_name || '',\n    media_url: body.media_url || null,\n    message_id: body.message_id || ''\n  }\n}];"
      },
      "id": "normalize-payload",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/agent/invoke",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone_number",
              "value": "={{ $json.phone_number }}"
            },
            {
              "name": "conversation_id",
              "value": "={{ $json.conversation_id }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "contact_name",
              "value": "={{ $json.contact_name }}"
            }
          ]
        },
        "options": {}
      },
      "id": "call-agent",
      "name": "Call Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"reply_sent\": true }",
        "options": {}
      },
      "id": "respond-to-kapso",
      "name": "Respond to Kapso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Kapso Webhook": {
      "main": [
        [
          {
            "node": "Normalize Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "Call Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Agent": {
      "main": [
        [
          {
            "node": "Respond to Kapso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
