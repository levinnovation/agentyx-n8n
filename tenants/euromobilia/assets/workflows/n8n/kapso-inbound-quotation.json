{
  "name": "Kapso Inbound Quotation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kapso-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "kapso-webhook",
      "name": "Kapso Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "kapso-inbound"
    },
    {
      "parameters": {
        "jsCode": "// Normalize Kapso payload to agent format\nconst body = $input.first().json.body;\nconst msg = body.message || {};\nconst conv = body.conversation || {};\n\n// Extract message text and media URL based on type\nlet messageText = '';\nlet mediaUrl = null;\nif (msg.type === 'text' && msg.text) {\n  messageText = msg.text.body || '';\n} else if (msg.type === 'image' && msg.image) {\n  messageText = msg.image.caption || '[Image received]';\n  mediaUrl = msg.image.link || null;\n} else if (msg.type === 'document' && msg.document) {\n  messageText = msg.document.caption || '[Document received]';\n  mediaUrl = msg.document.link || null;\n} else if (msg.type === 'voice' && msg.voice) {\n  messageText = '[Voice message received]';\n  mediaUrl = msg.voice.link || null;\n}\n\nconst phoneNumber = conv.phone_number ? '+' + conv.phone_number : (msg.from ? '+' + msg.from : '');\n\nreturn [{\n  json: {\n    phone_number: phoneNumber,\n    conversation_id: conv.id || msg.from || '',\n    message: messageText,\n    contact_name: conv.contact_name || '',\n    media_url: mediaUrl,\n    message_id: msg.id || ''\n  }\n}];"
      },
      "id": "normalize-payload",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_BASE_URL }}/agent/invoke",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "phone_number",
              "value": "={{ $json.phone_number }}"
            },
            {
              "name": "conversation_id",
              "value": "={{ $json.conversation_id }}"
            },
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "contact_name",
              "value": "={{ $json.contact_name }}"
            },
            {
              "name": "media_url",
              "value": "={{ $json.media_url }}"
            },
            {
              "name": "message_id",
              "value": "={{ $json.message_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "call-agent",
      "name": "Call Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"reply_sent\": true }",
        "options": {}
      },
      "id": "respond-to-kapso",
      "name": "Respond to Kapso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [840, 300]
    }
  ],
  "connections": {
    "Kapso Webhook": {
      "main": [
        [
          {
            "node": "Normalize Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "Call Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Agent": {
      "main": [
        [
          {
            "node": "Respond to Kapso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": ["euromobilia", "whatsapp", "kitchen-quotation", "mcp"],
  "staticData": null
}
