{
  "name": "Human Handoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "euromobilia-handoff",
        "responseMode": "onReceived",
        "options": {
          "responseData": {
            "values": {
              "respondWith": "json",
              "responseBody": "{\"status\":\"handoff_triggered\"}"
            }
          }
        }
      },
      "id": "handoff-webhook",
      "name": "Handoff Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "euromobilia-handoff"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KAPSO_BASE_URL }}/{{ $env.KAPSO_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.KAPSO_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "recipient_type",
              "value": "individual"
            },
            {
              "name": "to",
              "value": "={{ $env.ADMIN_PHONE_NUMBER }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={\"body\":\"ALERTA: Escalamiento humano\\nTelefono: {{ $json.body.phone_number }}\\nMotivo: {{ $json.body.reason || 'Cliente solicito agente humano' }}\\nHora: {{ new Date().toISOString() }}\"}"
            }
          ]
        },
        "options": {}
      },
      "id": "kapso-notify",
      "name": "Kapso WhatsApp Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COMPOSIO_MCP_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.COMPOSIO_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "toolkit": "bitrix24",
          "action": "bitrix24_create_lead",
          "params": {
            "title": "Handoff: {{ $json.body.phone_number }}",
            "phone": "{{ $json.body.phone_number }}",
            "source": "whatsapp",
            "comments": "{{ $json.body.reason || 'Customer requested human agent' }}"
          }
        },
        "options": {}
      },
      "id": "composio-bitrix24",
      "name": "Composio Bitrix24",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [640, 300]
    }
  ],
  "connections": {
    "Handoff Webhook": {
      "main": [
        [
          {
            "node": "Kapso WhatsApp Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kapso WhatsApp Notify": {
      "main": [
        [
          {
            "node": "Composio Bitrix24",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": ["euromobilia", "handoff", "kitchen-quotation", "mcp"],
  "staticData": null
}
