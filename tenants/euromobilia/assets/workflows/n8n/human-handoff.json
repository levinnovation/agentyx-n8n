{
  "name": "Human Handoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "euromobilia-handoff",
        "responseMode": "onReceived",
        "options": {
          "responseData": {
            "values": {
              "respondWith": "json",
              "responseBody": "{\"status\":\"handoff_triggered\"}"
            }
          }
        }
      },
      "id": "handoff-webhook",
      "name": "Handoff Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "euromobilia-handoff"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "text": "=:warning: Human handoff requested\n*Phone:* {{ $json.body.phone_number }}\n*Reason:* {{ $json.body.reason || 'Customer requested human agent' }}"
        },
        "options": {}
      },
      "id": "slack-notify",
      "name": "Slack Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    }
  ],
  "connections": {
    "Handoff Webhook": {
      "main": [
        [
          {
            "node": "Slack Notify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": ["euromobilia", "handoff", "kitchen-quotation"],
  "staticData": null
}
