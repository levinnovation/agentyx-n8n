# ============================================================
# Euromobilia Railway Stack — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to Git.
# ============================================================

# ─── Global ──────────────────────────────────────────────────
RAILWAY_TOKEN=

# ─── better-auth ─────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_DATABASE_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_HD=
OIDC_ISSUER=
OIDC_JWKS_PRIVATE_KEY=

# ─── auth-proxy ──────────────────────────────────────────────
N8N_PUBLIC_HOST=
FLOWISE_PUBLIC_HOST=
PAPERCLIP_PUBLIC_HOST=

# ─── n8n ─────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
WEBHOOK_URL=

# ─── LibreChat ───────────────────────────────────────────────
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
DOMAIN_CLIENT=
DOMAIN_SERVER=
CUSTOM_API_KEY=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_ISSUER=
OPENID_SCOPE=openid email profile
OPENID_BUTTON_LABEL=Sign in with Agentyx

# ─── Paperclip ───────────────────────────────────────────────
PAPERCLIP_DATABASE_URL=
PAPERCLIP_AUTH_SECRET=
PAPERCLIP_AGENT_REGISTRY_URL=

# ─── Langfuse ────────────────────────────────────────────────
NEXTAUTH_URL=
NEXTAUTH_SECRET=
SALT=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
AUTH_CUSTOM_NAME=Agentyx
AUTH_CUSTOM_CLIENT_ID=
AUTH_CUSTOM_CLIENT_SECRET=
AUTH_CUSTOM_ISSUER=
AUTH_CUSTOM_SCOPE=openid email profile

# ─── Agent ───────────────────────────────────────────────────
AGENT_IMAGE=ghcr.io/<org>/euromobilia-agent-quotation-assistant:latest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o
KAPSO_API_KEY=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_WEBHOOK_SECRET=
BITRIX24_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
COMPOSIO_API_KEY=
TAVILY_API_KEY=
REPLICATE_API_TOKEN=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=euromobilia-quotation
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_ENABLED=true
FAISS_INDEX_DIR=./.data/faiss_index
BETTER_AUTH_JWKS_URL=
BETTER_AUTH_ISSUER=
BETTER_AUTH_AUDIENCE=
AUTH_REQUIRED=false

# ─── Agentyx Portal ──────────────────────────────────────────
PORTAL_IMAGE=ghcr.io/<org>/agentyx-portal:latest

# ─── Flowise (optional) ──────────────────────────────────────
FLOWISE_ENABLED=false
FLOWISE_USERNAME=
FLOWISE_PASSWORD=
