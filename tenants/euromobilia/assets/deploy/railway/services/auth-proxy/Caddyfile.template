{$N8N_PUBLIC_HOST} {
  @n8n_webhooks path /webhook /webhook/* /form /form/* /rest/oauth2-credential/callback /rest/oauth1-credential/callback
  @n8n_test_webhooks path /webhook-test /webhook-test/* /webhook-waiting /webhook-waiting/*
  handle @n8n_webhooks {
    reverse_proxy {$N8N_WEBHOOK_INTERNAL_URL}
  }
  handle @n8n_test_webhooks {
    reverse_proxy {$N8N_INTERNAL_URL}
  }
  handle {
    forward_auth {$BETTER_AUTH_INTERNAL_URL} {
      uri /api/auth/forward-auth
      copy_headers X-Auth-Email
    }
    reverse_proxy {$N8N_INTERNAL_URL}
  }
}

{$FLOWISE_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$FLOWISE_INTERNAL_URL}
}

{$PAPERCLIP_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$PAPERCLIP_INTERNAL_URL}
}
