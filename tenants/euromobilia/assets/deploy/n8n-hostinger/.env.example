# Copy to .env on the VPS only (never commit .env).
# Replace all placeholder values before first boot.

# --- n8n public URL (IP bootstrap; move to https + domain before production) ---
N8N_HOST=187.127.252.161
N8N_PROTOCOL=http
WEBHOOK_URL=http://187.127.252.161/
N8N_EDITOR_BASE_URL=http://187.127.252.161/
# Required while serving the editor over plain HTTP:
N8N_SECURE_COOKIE=false

# --- n8n encryption (generate: openssl rand -hex 32) ---
N8N_ENCRYPTION_KEY=

# --- Postgres (n8n database) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
