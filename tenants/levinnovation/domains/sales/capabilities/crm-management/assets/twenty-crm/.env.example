# Twenty CRM Environment Variables
# Copy to Railway service variables. Do NOT commit secrets.

# ─── Core ──────────────────────────────────────────────────────
SERVER_URL=https://levinnovation.crm.agentyx.one
APP_SECRET=                              # openssl rand -base64 32

# ─── Database ──────────────────────────────────────────────────
PG_DATABASE_URL=                         # postgres://.../railway?schema=twenty_crm
PG_DATABASE_HOST=                        # From Railway Postgres plugin
PG_DATABASE_PORT=5432
PG_DATABASE_USER=                        # From Railway Postgres plugin
PG_DATABASE_PASSWORD=                    # From Railway Postgres plugin
PG_DATABASE_NAME=twenty_crm

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=                               # redis://redis:6379 or Railway Redis ref

# ─── Storage (Railway Bucket) ──────────────────────────────────
STORAGE_TYPE=S_3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=                         # Railway bucket name
STORAGE_S3_ENDPOINT=                     # Railway bucket endpoint
STORAGE_S3_ACCESS_KEY_ID=                # Railway bucket access key
STORAGE_S3_SECRET_ACCESS_KEY=            # Railway bucket secret key

# ─── Node / Server ─────────────────────────────────────────────
NODE_ENV=production
NODE_PORT=3000

# ─── Features ──────────────────────────────────────────────────
IS_MULTIWORKSPACE_ENABLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# ─── Email (configure via admin panel or env) ──────────────────
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# ─── Worker-specific ───────────────────────────────────────────
# DISABLE_DB_MIGRATIONS=true            # Set on worker only
# DISABLE_CRON_JOBS_REGISTRATION=true   # Set on worker only
