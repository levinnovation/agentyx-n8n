    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ \"DELETE FROM public.cs_knowledge_chunks WHERE doc_id = '\" + ($json.doc_id || '').replace(/'/g, \"''\") + \"';\" }}",
        "options": {}
