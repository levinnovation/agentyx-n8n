      "parameters": {
        "jsCode": "const file = $input.first().json;\nconst raw = $input.first().binary?.data;\nlet text = '';\nif (typeof raw === 'string') text = raw;\nelse if (raw && raw.data) text = Buffer.from(raw.data, 'base64').toString('utf-8');\nelse if (typeof $json === 'string') text = $json;\nelse text = JSON.stringify($json||{});\ntext = String(text||'').replace(/\\u0000/g,'').trim();\nreturn [{json:{...file,raw_text:text}}];"
      },
