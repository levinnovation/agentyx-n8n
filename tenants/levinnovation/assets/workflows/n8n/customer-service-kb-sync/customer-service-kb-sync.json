    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn all.map(item => {\n  const json = item.json;\n  const emb = (item.json.data || [])[0]?.embedding || [];\n  const embLit = '[' + emb.join(',') + ']';\n  return { json: { ...json, embedding: embLit } };\n});"
      },
