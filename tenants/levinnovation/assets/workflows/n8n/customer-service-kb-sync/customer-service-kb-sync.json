    {
      "parameters": {
        "jsCode": "const batch=$json.batch||[];\nconst content=$json.choices?.[0]?.message?.content||'';\nlet tags=[];\ntry{ const m=content.match(/\\{.*\\}/s); if(m) tags=JSON.parse(m[0]).tags||[]; }catch(e){}\nif(!tags.length) tags=batch.map(()=>'General');\nreturn batch.map((item,idx)=>({json:{...item,product:tags[idx]||'General'}}));"
      },
      "id": "kb-sync-v2-dist-tags",
      "name": "Distribute Tags",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5020,
        240
