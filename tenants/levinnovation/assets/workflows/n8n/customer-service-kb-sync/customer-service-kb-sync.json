    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"INSERT INTO public.cs_documents (source,source_id,product,title,url,mime,raw_text,content_hash,version,updated_at) VALUES ('google-drive', '\" + ($json.source_id||'').replace(/'/g,\"''\") + \"', 'General', '\" + ($json.title||'').replace(/'/g,\"''\") + \"', '\" + ($json.url||'').replace(/'/g,\"''\") + \"', '\" + ($json.mime||'').replace(/'/g,\"''\") + \"', '\" + ($json.raw_text||'').replace(/'/g,\"''\").slice(0,60000) + \"', '\" + ($json.content_hash||'').replace(/'/g,\"''\") + \"', 1, now()) ON CONFLICT (source,source_id) DO UPDATE SET title=EXCLUDED.title, url=EXCLUDED.url, mime=EXCLUDED.mime, raw_text=EXCLUDED.raw_text, content_hash=EXCLUDED.content_hash, version=cs_documents.version+1, updated_at=now() RETURNING id;\" }}"
      },
