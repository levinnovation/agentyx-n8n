      "parameters": {
        "jsCode": "const file = $input.first().json;\nconst binary = $input.first().binary?.data;\nlet text = '';\nif (typeof binary === 'string') {\n  text = binary;\n} else if (binary && binary.data) {\n  text = Buffer.from(binary.data, 'base64').toString('utf-8');\n} else if (typeof $json === 'string') {\n  text = $json;\n} else {\n  text = JSON.stringify($json || {});\n}\ntext = String(text || '').replace(/\\u0000/g, '').trim();\nreturn [{ json: { ...file, raw_text: text } }];"
      },
