        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'google/gemini-2.5-flash', messages: [{role:'system',content:'Eres un clasificador de contenido. Responde solo con JSON.'},{role:'user',content:$json.prompt}], temperature: 0.1 } }}",
        "options": {
          "timeout": 30000
