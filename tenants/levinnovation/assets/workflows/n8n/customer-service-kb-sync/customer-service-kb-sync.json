    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nfunction chunkText(text,chunkSize=1200,overlap=150){\n  const seps=['\\n\\n','\\n','. ','? ','! ','; ',', ',' '];\n  const chunks=[];\n  function split(t,level){\n    if (t.length<=chunkSize){ chunks.push(t); return; }\n    const sep=seps[level]||'';\n    if (!sep){ for(let i=0;i<t.length;i+=chunkSize-overlap) chunks.push(t.slice(i,i+chunkSize)); return; }\n    const parts=t.split(sep); let cur='';\n    for (const part of parts){\n      const cand=cur?cur+sep+part:part;\n      if (cand.length<=chunkSize) cur=cand;\n      else { if(cur) split(cur,level+1); cur=part; }\n    }\n    if(cur) split(cur,level+1);\n  }\n  split(text,0);\n  return chunks.filter(c=>c.trim().length>20);\n}\nconst chunks=chunkText(item.raw_text||'',1200,150);\nreturn chunks.map((c,idx)=>({json:{...item,chunk_text:c,chunk_index:idx,chunk_type:'text'}}));"
      },
      "id": "kb-sync-v2-chunk",
      "name": "Recursive Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4300,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json);\nconst size=10; const batches=[];\nfor(let i=0;i<items.length;i+=size){\n  const batch=items.slice(i,i+size);\n  const lines=batch.map((b,idx)=>`${idx+1}. ${b.chunk_text}`);\n  const prompt=`Clasifica cada texto en EXACTAMENTE UNA categoria: Agentyx, Contax, Acumatica, Oosto, Metropolis, Legalink, Pricing, CaseStudy, FAQ, General.\\nResponde SOLO con JSON: {\"tags\":[\"Cat1\",\"Cat2\",...]}\\n\\n${lines.join('\\n')}`;\n  batches.push({batch,prompt});\n}\nreturn batches.map(b=>({json:b}));"
      },
