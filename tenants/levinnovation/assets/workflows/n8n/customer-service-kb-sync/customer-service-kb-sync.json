      "id": "list",
      "name": "List Drive Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        944,
        368
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "v7kCbCgLS3aXRqtp",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst allowed = ['text/plain','application/pdf','application/vnd.google-apps.document','application/vnd.google-apps.spreadsheet','text/markdown'];\nconst folderMimes = ['application/vnd.google-apps.folder','application/vnd.google-apps.shortcut'];\nconst extToMime = {\n  'txt': 'text/plain',\n  'md': 'text/plain',\n  'pdf': 'application/pdf'\n};\nreturn items\n  .filter(f => !folderMimes.includes(f.mimeType))\n  .filter(f => f.trashed !== true)\n  .filter(f => {\n    if (allowed.includes(f.mimeType)) return true;\n    const name = String(f.name || '').toLowerCase();\n    const ext = name.split('.').pop();\n    if (extToMime[ext]) return true;\n    if (name.includes('context') || name.includes('acumatica') || name.includes('contax') || name.includes('costo') || name.includes('shareable')) return true;\n    return false;\n  })\n  .map(f => {\n    const name = String(f.name || '').toLowerCase();\n    const ext = name.split('.').pop();\n    let mime = f.mimeType || extToMime[ext] || 'application/vnd.google-apps.document';\n    return {\n      json: {\n        source: 'google-drive',\n        source_id: f.id,\n        title: f.name,\n        url: f.webViewLink || `https://drive.google.com/file/d/${f.id}/view`,\n        mime: mime,\n        modified_time: f.modifiedTime || new Date().toISOString()\n      }\n    };\n  });"
      },
      "id": "filter",
      "name": "Filter Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        368
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.source_id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/markdown"
            }
          }
        }
      },
      "id": "dl",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1664,
        368
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "v7kCbCgLS3aXRqtp",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn all.map(item => {\n  const json = item.json;\n  let text = '';\n\n  // 1. Binary download (regular files OR Google Doc export stored as binary)\n  if (item.binary) {\n    const binObj = item.binary.data;\n    if (binObj && binObj.data) {\n      try {\n        text = Buffer.from(binObj.data, 'base64').toString('utf-8');\n      } catch (e) {\n        text = String(binObj.data || '');\n      }\n    }\n  }\n\n  // 2. Fallback: if item.json itself is a string (text export)\n  if (!text && typeof item.json === 'string') {\n    text = item.json;\n  }\n\n  // 3. Fallback: extract string values from json object\n  if (!text && json && typeof json === 'object') {\n    const vals = Object.values(json).filter(v => typeof v === 'string');\n    text = vals.join('\\n');\n  }\n\n  text = text.replace(/\\u0000/g, '').trim();\n  return { json: { ...json, raw_text: text } };\n});"
      },
      "id": "extract",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn all.map(item => {\n  const json = item.json;\n  const text = String(json.raw_text || '').trim().replace(/\\s+/g, ' ');\n  let h = 0x811c9dc5;\n  for (let i = 0; i < text.length; i++) { h ^= text.charCodeAt(i); h = Math.imul(h, 0x01000193); }\n  const hash = (h >>> 0).toString(16).padStart(8, '0');\n  return { json: { ...json, raw_text: text, content_hash: hash } };\n});"
      },
      "id": "hash",
      "name": "Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2384,
        368
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "{{ \"SELECT content_hash FROM public.cs_documents WHERE source = 'google-drive' AND source_id = '\" + ($json.source_id || '').replace(/'/g, \"''\") + \"';\" }}",
        "options": {}
      },
      "id": "check",
      "name": "Check Hash",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
