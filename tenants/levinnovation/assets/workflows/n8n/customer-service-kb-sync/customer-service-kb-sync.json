    {
      "parameters": {
        "jsCode": "const all = $input.all().map(i => i.json);\nconst rootFolderId = String($('Load Config').item.json.root_folder_id || '');\nconst byId = new Map(all.map(f => [String(f.id), f]));\nfunction hasRoot(f, seen=new Set()) {\n  const id = String(f?.id||''); if (!id || seen.has(id)) return false; seen.add(id);\n  const ps = Array.isArray(f.parents)?f.parents:[];\n  if (ps.includes(rootFolderId)) return true;\n  for (const pid of ps) { if (pid===rootFolderId) return true; const p=byId.get(pid); if (p&&hasRoot(p,seen)) return true; }\n  return false;\n}\nconst allowed = new Set(['text/plain','application/pdf','application/vnd.google-apps.document','application/vnd.google-apps.spreadsheet']);\nconst driveItems = all\n  .filter(f => !f.trashed)\n  .filter(f => allowed.has(String(f.mimeType || '')))\n  .filter(f => hasRoot(f))\n  .map(f => ({\n    source: 'google-drive',\n    source_id: f.id,\n    title: f.name,\n    url: f.webViewLink || '',\n    mime: f.mimeType,\n    modified_time: f.modifiedTime || ''\n  }));\n\nconst staticInput = $('Fetch Static Catalog').item?.json || {};\nconst staticDocs = Array.isArray(staticInput.documents) ? staticInput.documents : [];\nconst staticItems = staticDocs.map(d => ({\n  source: 'static',\n  source_id: d.source_id,\n  title: d.title,\n  url: d.url || '',\n  mime: d.mime,\n  modified_time: '',\n  raw_text: d.raw_text\n}));\n\nreturn [...driveItems, ...staticItems].map(i => ({ json: i }));"
      },
