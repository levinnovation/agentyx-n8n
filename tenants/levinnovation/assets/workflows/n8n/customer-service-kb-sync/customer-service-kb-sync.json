      "id": "del",
      "name": "Delete Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3584,
        128
      ],
      "credentials": {
        "postgres": {
          "id": "sFReUGjhi6Ox1tYR",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const all = $input.all();\nlet out = [];\nfor (const item of all) {\n  const json = item.json;\n  const text = String(json.raw_text || '');\n  const size = 1200, overlap = 150;\n  const chunks = [];\n  for (let i = 0; i < text.length; i += size - overlap) {\n    chunks.push(text.slice(i, i + size));\n  }\n  const valid = chunks.filter(c => c.trim().length > 20);\n  valid.forEach((c, idx) => {\n    out.push({ json: { ...json, chunk_text: c, chunk_index: idx } });\n  });\n}\nreturn out;"
      },
      "id": "chunk",
      "name": "Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3824,
        128
