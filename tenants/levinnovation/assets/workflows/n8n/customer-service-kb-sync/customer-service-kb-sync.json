    {
      "parameters": {
        "url": "={{ 'https://www.googleapis.com/drive/v3/files?pageSize=1000&fields=files(id,name,mimeType,parents,modifiedTime,trashed,webViewLink,md5Checksum),nextPageToken&q=' + encodeURIComponent('trashed = false') }}",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "list",
      "name": "List Drive Files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        240
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "v7kCbCgLS3aXRqtp",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.first().json || {};\nconst files = Array.isArray(resp.files) ? resp.files : [];\n\n// Filter to non-folder files only\nconst docFiles = files.filter(f => f.mimeType !== 'application/vnd.google-apps.folder');\n\nreturn [{ json: { files: docFiles, count: docFiles.length } }];"
      },
      "id": "filter",
      "name": "Filter Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const files = ($input.first().json || {}).files || [];\n\nreturn files.map(f => {\n  let url = '';\n  if (f.mimeType === 'application/vnd.google-apps.document') {\n    url = `https://www.googleapis.com/drive/v3/files/${f.id}/export?mimeType=text/plain`;\n  } else if (f.mimeType === 'application/vnd.google-apps.spreadsheet') {\n    url = `https://www.googleapis.com/drive/v3/files/${f.id}/export?mimeType=text/csv`;\n  } else {\n    url = `https://www.googleapis.com/drive/v3/files/${f.id}?alt=media`;\n  }\n  return {\n    json: {\n      source: 'google-drive',\n      source_id: f.id,\n      title: f.name,\n      url: f.webViewLink || '',\n      mime: f.mimeType,\n      download_url: url,\n      modified_time: f.modifiedTime || ''\n    }\n  };\n});"
      },
      "id": "map",
      "name": "Map Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1420,
        240
      ]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "split",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1660,
        240
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.download_url }}",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "dl",
      "name": "Download File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        240
      ],
      "continueOnFail": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "v7kCbCgLS3aXRqtp",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = $input.first().binary?.data;\nlet text = '';\nif (typeof raw === 'string') text = raw;\nelse if (raw && raw.data) text = Buffer.from(raw.data, 'base64').toString('utf-8');\nelse if (typeof $json === 'string') text = $json;\nelse text = JSON.stringify($json||{});\ntext = String(text||'').replace(/\\u0000/g,'').trim();\nreturn [{json:{...item,raw_text:text}}];"
      },
      "id": "extract",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst text = String(item.raw_text||'').trim().replace(/\\s+/g,' ');\nconst hash = require('crypto').createHash('sha256').update(text).digest('hex');\nreturn [{json:{...item,raw_text:text,content_hash:hash}}];"
      },
      "id": "hash",
      "name": "Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2380,
        240
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"SELECT content_hash FROM public.cs_documents WHERE source = 'google-drive' AND source_id = '\" + ($json.source_id||'').replace(/'/g,\"''\") + \"';\" }}"
      },
      "id": "check",
      "name": "Check Hash",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2620,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "sFReUGjhi6Ox1tYR",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond1",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.content_hash === $('Hash').item.json.content_hash }}",
              "rightValue": "true"
            }
          ]
        },
        "options": {}
