        "jsCode": "const batch=$json.batch||[];\nconst embeddings=($json.data||[]).map(d=>d.embedding);\nreturn batch.map((item,idx)=>({json:{...item,embedding:embeddings[idx]||[]}}));"
      },
      "id": "kb-sync-v2-dist-embed",
      "name": "Distribute Embeddings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5740,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json);\nif(!items.length) return [{json:{sql:'SELECT 1;',count:0}}];\nconst vals=items.map(item=>{\n  const emb='['+(item.embedding||[]).join(',')+']';\n  const meta=JSON.stringify({doc_id:item.doc_id,product:item.product,source:item.source,source_id:item.source_id,url:item.url,chunk_index:item.chunk_index}).replace(/'/g,\"''\");\n  return `('${item.chunk_text.replace(/'/g,\"''\").slice(0,8000)}','${meta}'::jsonb,'${emb}'::vector,'${item.doc_id}',${item.chunk_index})`;\n}).join(', ');\nconst sql=`INSERT INTO public.cs_knowledge_chunks (text,metadata,embedding,doc_id,chunk_index) VALUES ${vals};`;\nreturn [{json:{sql,count:items.length}}];"
      },
