    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"INSERT INTO public.cs_knowledge_chunks (text, metadata, embedding, doc_id, chunk_index) VALUES ('\" + ($json.chunk_text||'').replace(/'/g,\"''\").slice(0,8000) + \"', '\" + JSON.stringify({doc_id: $json.doc_id, product: 'General', source: 'google-drive', source_id: $json.source_id, url: $json.url, chunk_index: $json.chunk_index}).replace(/'/g,\"''\") + \"'::jsonb, '\" + ($json.embedding||'[]') + \"'::vector, '\" + ($json.doc_id||'').replace(/'/g,\"''\") + \"', \" + ($json.chunk_index||0) + \");\" }}"
      },
      "id": "insert",
      "name": "Insert Chunk",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        4540,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "sFReUGjhi6Ox1tYR",
          "name": "Postgres account"
        }
      }
