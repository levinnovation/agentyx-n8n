    },
    {
      "parameters": {
        "jsCode": "const items=$input.all().map(i=>i.json);\nconst size=96; const batches=[];\nfor(let i=0;i<items.length;i+=size){\n  const batch=items.slice(i,i+size);\n  batches.push({batch,texts:batch.map(b=>b.chunk_text)});\n}\nreturn batches.map(b=>({json:b}));"
      },
