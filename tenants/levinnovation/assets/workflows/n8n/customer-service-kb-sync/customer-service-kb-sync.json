    {
      "parameters": {
        "jsCode": "const all = $input.all().map(i => i.json);\nlet driveFiles = [];\nlet staticDocs = [];\nfor (const item of all) {\n  if (Array.isArray(item.files)) driveFiles = item.files;\n  if (Array.isArray(item.documents)) staticDocs = item.documents;\n}\nconst allowed = new Set(['text/plain','application/pdf','application/vnd.google-apps.document','application/vnd.google-apps.spreadsheet','text/markdown']);\nconst driveItems = driveFiles\n  .filter(f => !f.trashed)\n  .filter(f => allowed.has(String(f.mimeType || '')))\n  .map(f => {\n    let url='';\n    if (f.mimeType==='application/vnd.google-apps.document') url=`https://www.googleapis.com/drive/v3/files/${f.id}/export?mimeType=text/plain`;\n    else if (f.mimeType==='application/vnd.google-apps.spreadsheet') url=`https://www.googleapis.com/drive/v3/files/${f.id}/export?mimeType=text/csv`;\n    else url=`https://www.googleapis.com/drive/v3/files/${f.id}?alt=media`;\n    return {source:'google-drive',source_id:f.id,title:f.name,url:f.webViewLink||'',mime:f.mimeType,download_url:url,modified_time:f.modifiedTime||'',raw_text:''};\n  });\nconst staticItems = staticDocs.map(d => ({\n  source: 'static',\n  source_id: d.source_id,\n  title: d.title,\n  url: d.url || '',\n  mime: d.mime,\n  modified_time: '',\n  raw_text: d.raw_text\n}));\nreturn [...driveItems, ...staticItems].map(i => ({ json: i }));"
      },
