      "id": "kb-sync-v2-delete-chunks",
      "name": "Delete Chunks by Doc",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        4060,
        240
      ],
      "credentials": {
        "postgres": {
          "id": "sFReUGjhi6Ox1tYR",
          "name": "Postgres account"
        }
