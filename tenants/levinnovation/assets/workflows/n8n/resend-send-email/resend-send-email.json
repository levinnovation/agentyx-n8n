{
  "name": "Resend Send Email",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [224, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "debug_input",
              "value": "={{ JSON.stringify($json) }}",
              "type": "string"
            },
            {
              "name": "to",
              "value": "={{ $json.query?.to || $json.to || '' }}",
              "type": "string"
            },
            {
              "name": "from",
              "value": "={{ $json.query?.from || $json.from || 'me' }}",
              "type": "string"
            },
            {
              "name": "subject",
              "value": "={{ $json.query?.subject || $json.subject || '' }}",
              "type": "string"
            },
            {
              "name": "html",
              "value": "={{ $json.query?.html || $json.query?.body || $json.html || $json.body || $json.text || '<p>No content</p>' }}",
              "type": "string"
            },
            {
              "name": "cc",
              "value": "={{ JSON.stringify($json.query?.cc || $json.cc || []) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "map-fields",
      "name": "Map Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [464, 240]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst to = item.to || '';\nconst from_addr = item.from || 'me';\nconst subject = item.subject || '';\nconst html = item.html || '<p>No content</p>';\nconst ccStr = item.cc || '[]';\n\nlet cc = [];\ntry {\n  cc = JSON.parse(ccStr);\n} catch (e) {\n  cc = [];\n}\n\nconst payload = {\n  to: to,\n  from: from_addr,\n  subject: subject,\n  html: html\n};\n\nif (cc && Array.isArray(cc) && cc.length > 0) {\n  payload.cc = cc;\n}\n\nreturn [{ json: payload }];"
      },
      "id": "build-payload",
      "name": "Build Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [704, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer re_q8mwDvFD_BgTcBXWwsdhFTN7YKEZ9KQMC"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "send-request",
      "name": "Send via Resend API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [944, 240]
    }
  ],
