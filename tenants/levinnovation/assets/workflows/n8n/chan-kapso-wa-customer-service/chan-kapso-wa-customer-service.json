    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Kapso sends payload directly (not wrapped in .body)\nconst body = input.body || input || {};\nconst msg = body.message || {};\nconst conv = body.conversation || {};\n\nlet messageText = '';\nlet attachments = [];\n\nif (msg.type === 'text' && msg.text) {\n  messageText = msg.text.body || '';\n} else if (msg.type === 'image' && msg.image) {\n  messageText = msg.image.caption || '[Imagen recibida]';\n  attachments.push({ type: 'image', url: msg.image.link || '', mime_type: msg.image.mime_type || 'image/jpeg' });\n} else if (msg.type === 'document' && msg.document) {\n  messageText = msg.document.caption || '[Documento recibido]';\n  attachments.push({ type: 'document', url: msg.document.link || '', mime_type: msg.document.mime_type || 'application/pdf' });\n} else if (msg.type === 'voice' && msg.voice) {\n  messageText = '[Mensaje de voz recibido]';\n  attachments.push({ type: 'voice', url: msg.voice.link || '', mime_type: msg.voice.mime_type || 'audio/ogg' });\n} else if (msg.type === 'audio' && msg.audio) {\n  messageText = '[Audio recibido]';\n  attachments.push({ type: 'audio', url: msg.audio.link || '', mime_type: msg.audio.mime_type || 'audio/mpeg' });\n}\n\nconst phoneNumber = conv.phone_number ? '+' + conv.phone_number : (msg.from ? '+' + msg.from : '');\n\nreturn [{\n  json: {\n    core_workflow_id: 'n0mTwpONyCbbyn2E',\n    channel: 'kapso-wa',\n    conversation_id: String(conv.id || msg.from || ''),\n    user_id: String(phoneNumber || ''),\n    message: messageText,\n    attachments: attachments,\n    metadata: {\n      message_id: msg.id || '',\n      contact_name: conv.contact_name || '',\n      phone: phoneNumber,\n      phone_number_id: conv.phone_number_id || ''\n    }\n  }\n}];"
      },
