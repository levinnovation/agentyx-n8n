{
  "name": "KB Search - Postgres (Levinnovation)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kb/search",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "kb-search-webhook",
      "name": "KB Search Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        260
      ],
      "webhookId": "kb-search-levinnovation"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "query",
              "value": "={{ ($json.body && $json.body.query) || $json.query || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "kb-search-normalize",
      "name": "Normalize Query",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        260
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ \"SELECT id, text as chunk_text, metadata, created_at as modified_time FROM public.cs_knowledge_chunks WHERE text ILIKE '%\" + (($json.query || '').substring(0, 120).replace(/'/g, \"''\")) + \"%' ORDER BY created_at DESC LIMIT 6;\" }}"
      },
      "id": "kb-search-postgres",
      "name": "Search KB Chunks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        700,
        260
      ],
      "continueOnFail": true,
      "credentials": {
        "postgres": {
          "id": "sFReUGjhi6Ox1tYR",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json || {});\nconst snippets = rows.filter((r) => r.chunk_text).map((r) => ({ file_name: (r.metadata && (r.metadata.source_name || r.metadata.source_file_id)) || 'doc', chunk_text: String(r.chunk_text || '').slice(0, 800), modified_time: r.modified_time || null }));\nconst kbContext = snippets.map((s, idx) => `#${idx + 1} [${s.file_name}]\\n${s.chunk_text}`).join('\\n\\n');\nreturn [{ json: { kb_context: kbContext, snippets, hit_count: snippets.length } }];"
      },
      "id": "kb-search-format",
      "name": "Format KB Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        260
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, kb_context: $json.kb_context || '', snippets: $json.snippets || [], hit_count: $json.hit_count || 0 } }}",
        "options": {}
      },
      "id": "kb-search-respond",
      "name": "Respond KB",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.3,
      "position": [
        1180,
        260
      ]
    }
  ],
  "connections": {
    "KB Search Webhook": {
      "main": [
        [
          {
            "node": "Normalize Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Query": {
      "main": [
        [
          {
            "node": "Search KB Chunks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Search KB Chunks": {
      "main": [
        [
          {
            "node": "Format KB Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format KB Context": {
      "main": [
        [
          {
            "node": "Respond KB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true,
    "timezone": "America/Costa_Rica"
  }
}
