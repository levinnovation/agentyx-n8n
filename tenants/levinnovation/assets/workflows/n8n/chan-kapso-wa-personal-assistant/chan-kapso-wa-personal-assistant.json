{
  "name": "Channel Adapter - Kapso WA Personal Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kapso/personal-assistant",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0f385a8e-23ff-4c72-8d4f-bbc8a3734c7e",
      "name": "Kapso Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        240
      ],
      "webhookId": "kapso-personal-assistant"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || {};\nconst msg = body.message || {};\nconst conv = body.conversation || {};\n\nlet messageText = '';\nlet mediaUrl = null;\nif (msg.type === 'text' && msg.text) {\n  messageText = msg.text.body || '';\n} else if (msg.type === 'image' && msg.image) {\n  messageText = msg.image.caption || '[Image received]';\n  mediaUrl = msg.image.link || null;\n} else if (msg.type === 'document' && msg.document) {\n  messageText = msg.document.caption || '[Document received]';\n  mediaUrl = msg.document.link || null;\n} else if (msg.type === 'voice' && msg.voice) {\n  messageText = '[Voice message received]';\n  mediaUrl = msg.voice.link || null;\n}\n\nconst phoneNumber = conv.phone_number ? '+' + conv.phone_number : (msg.from ? '+' + msg.from : '');\n\nreturn [{\n  json: {\n    core_workflow_id: '1USjs2JAP4tlHIcm',\n    channel: 'kapso-wa',\n    conversation_id: String(conv.id || msg.from || ''),\n    user_id: String(phoneNumber || ''),\n    message: messageText,\n    attachments: mediaUrl ? [{ type: msg.type || 'media', url: mediaUrl }] : [],\n    metadata: {\n      message_id: msg.id || '',\n      contact_name: conv.contact_name || ''\n    },\n    incoming_message_id: String(msg.id || ''),\n    phone_number: phoneNumber\n  }\n}];"
      },
      "id": "f63b2b5f-7f55-4fd7-b8f8-2f588f1af074",
      "name": "Validate + Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst messageId = String(item.incoming_message_id || item.metadata?.message_id || '').trim();\nconst globalData = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst ttlMs = 15 * 60 * 1000;\n\nconst seen = (globalData.seenKapsoMessageIds && typeof globalData.seenKapsoMessageIds === 'object')\n  ? globalData.seenKapsoMessageIds\n  : {};\n\nfor (const [key, ts] of Object.entries(seen)) {\n  if (typeof ts !== 'number' || now - ts > ttlMs) {\n    delete seen[key];\n  }\n}\n\nlet duplicateMessage = false;\nif (messageId) {\n  if (seen[messageId]) {\n    duplicateMessage = true;\n  } else {\n    seen[messageId] = now;\n  }\n}\n\nglobalData.seenKapsoMessageIds = seen;\n\nreturn [{\n  json: {\n    ...item,\n    duplicate_message: duplicateMessage,\n  },\n}];"
      },
      "id": "1e9f7029-9323-497b-8f06-4fcf7f2f789f",
      "name": "Deduplicate Incoming",
