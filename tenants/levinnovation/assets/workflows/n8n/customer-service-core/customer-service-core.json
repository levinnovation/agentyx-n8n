      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet text = raw.output || raw.text || raw.response || '';\nlet metadata = {};\nconst jsonMatch = text.match(/```json\\s*([\\s\\S]*?)\\s*```/);\nif (jsonMatch) {\n  try {\n    metadata = JSON.parse(jsonMatch[1]);\n    text = text.replace(jsonMatch[0], '').trim();\n  } catch (e) {}\n}\nreturn [{ json: { ...raw, reply_text: text, lead_status: metadata.lead_status || 'unknown', qualification_score: metadata.qualification_score || 0, meeting_requested: metadata.meeting_requested || false, crm_fields: metadata.crm_fields || {}, calendar_action: metadata.calendar_action || 'none', next_best_action: metadata.next_best_action || '' } }];"
