      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = '/Users/vinicioflores/agentyx-vertical-assets/tenants/levinnovation/assets/data/customer-service-knowledge.md';\nlet text = '';\ntry {\n  text = fs.readFileSync(path, 'utf-8');\n} catch (e) {\n  text = 'LEV Innovation ayuda a organizaciones a implementar automatizacion practica con IA.';\n}\nconst chunks = [];\nconst chunkSize = 2000;\nfor (let i = 0; i < text.length; i += chunkSize) {\n  chunks.push(text.substring(i, i + chunkSize));\n}\nreturn chunks.map((c, i) => ({ json: { chunk_id: i, text: c, source: 'customer-service-knowledge.md' } }));"
      },
