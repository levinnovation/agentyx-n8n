      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst binary = $input.first().binary?.data;\nlet docText = '';\nif (binary && binary.data) {\n  try {\n    docText = Buffer.from(binary.data, 'base64').toString('utf-8').substring(0, 8000);\n  } catch (e) {\n    docText = '[No se pudo extraer texto del documento]';\n  }\n} else {\n  docText = '[Documento sin contenido accesible]';\n}\nreturn [{ json: { ...item, document_text: docText, message: (item.message || '') + ' [Documento]: ' + docText.substring(0, 500) } }];"
      },
