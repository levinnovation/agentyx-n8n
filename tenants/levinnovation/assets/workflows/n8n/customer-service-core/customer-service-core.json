      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst attachments = item.attachments || [];\nconst hasAudio = attachments.some(a => ['audio','voice','audio/ogg','audio/mpeg'].includes(a.type || a.mime_type));\nconst hasImage = attachments.some(a => ['image','image/jpeg','image/png','image/jpg'].includes(a.type || a.mime_type));\nconst hasDocument = attachments.some(a => ['document','application/pdf','text/plain','application/msword'].includes(a.type || a.mime_type));\nconst audioAttachment = hasAudio ? attachments.find(a => ['audio','voice','audio/ogg','audio/mpeg'].includes(a.type || a.mime_type)) : null;\nconst imageAttachment = hasImage ? attachments.find(a => ['image','image/jpeg','image/png','image/jpg'].includes(a.type || a.mime_type)) : null;\nconst docAttachment = hasDocument ? attachments.find(a => ['document','application/pdf','text/plain','application/msword'].includes(a.type || a.mime_type)) : null;\nreturn [{\n  json: {\n    ...item,\n    _attachment_type: hasAudio ? 'audio' : (hasImage ? 'image' : (hasDocument ? 'document' : 'none')),\n    _audio_url: audioAttachment ? (audioAttachment.url || audioAttachment.link || '') : '',\n    _image_url: imageAttachment ? (imageAttachment.url || imageAttachment.link || '') : '',\n    _doc_url: docAttachment ? (docAttachment.url || docAttachment.link || '') : '',\n    _doc_mime: docAttachment ? (docAttachment.mime_type || docAttachment.type || 'application/octet-stream') : ''\n  }\n}];"
      },
