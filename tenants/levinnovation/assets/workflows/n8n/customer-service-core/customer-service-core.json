        "jsCode": "const item = $input.first().json;\nconst g = $getWorkflowStaticData('global');\ng.cs_audit_log = g.cs_audit_log || [];\ng.cs_audit_log.push({\n  ts: new Date().toISOString(),\n  channel: item.channel,\n  conversation_id: item.conversation_id,\n  user_id: item.user_id,\n  contact_name: item.contact_name,\n  lead_status: item.lead_status,\n  qualification_score: item.qualification_score,\n  meeting_requested: item.meeting_requested,\n  calendar_action: item.calendar_action,\n  reply_preview: (item.reply_text || '').substring(0, 200)\n});\nif (g.cs_audit_log.length > 2000) g.cs_audit_log.splice(0, g.cs_audit_log.length - 2000);\nreturn [{ json: { ...item, audit_logged: true } }];"
