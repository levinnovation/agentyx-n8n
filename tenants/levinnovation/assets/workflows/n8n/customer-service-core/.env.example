# Required environment variables

# LLM (OpenRouter)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=

# Composio MCP
MCP_ENDPOINT=https://levinnovation.mcp.agentyx.one/mcp
MCP_AUTH_TOKEN=

# Twenty CRM (update URL after Railway deploy)
TWENTY_BASE_URL=https://twenty-levinnovation.railway.app
TWENTY_API_KEY=

# Redis (for chat memory)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI (audio transcription via Whisper)
OPENAI_API_KEY=

# Knowledge base
CUSTOMER_SERVICE_SYSTEM_PROMPT_FILE=tenants/levinnovation/assets/prompts/customer-service-agent.system.md

# Slack audit log (optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#levinnovation
