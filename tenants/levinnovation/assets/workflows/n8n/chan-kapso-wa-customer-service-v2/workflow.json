{
  "name": "chan-kapso-wa-customer-service-v2",
  "id": "chan-kapso-wa-customer-service-v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kapso-customer-service-v2",
        "responseMode": "responseNode"
      },
      "id": "node-0",
      "name": "Kapso Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "kapso-customer-service-v2"
    },
    {
      "parameters": {
        "channel": "kapso-wa",
        "payload": "={{ JSON.stringify($json) }}",
        "coreWorkflowId": "customer-service-core-v2",
        "dedupTtlMinutes": 15
      },
      "id": "node-1",
      "name": "Channel Input",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxChannelFormattedInputNode",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": "customer-service-core-v2"
      },
      "id": "node-2",
      "name": "Execute Core",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "channel": "kapso-wa",
        "replyText": "={{ $json.reply_text }}",
        "recipientId": "={{ $json.user_id }}",
        "sendMethod": "api"
      },
      "id": "node-3",
      "name": "Channel Output",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxChannelFormattedOutputNode",
      "typeVersion": 1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"ok\" }"
      },
      "id": "node-4",
      "name": "Respond to Kapso",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1040,
        300
      ]
    }
  ],
  "connections": {
    "Kapso Webhook": {
      "main": [
        [
          {
            "node": "Channel Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Input": {
      "main": [
        [
          {
            "node": "Execute Core",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Core": {
      "main": [
        [
          {
            "node": "Channel Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Output": {
      "main": [
        [
          {
            "node": "Respond to Kapso",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    "channel-adapter",
    "kapso",
    "whatsapp",
    "v2"
  ],
  "active": false,
  "versionId": null
}