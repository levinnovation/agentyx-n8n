    {
      "parameters": {
        "jsCode": "const lead = $('Parse Qualification JSON').item.json;\nconst events = $input.all().map((i) => i.json).slice(0, 3);\nconst slots = events.length > 0\n  ? events.map((e) => `- ${e.start?.dateTime || e.start?.date || 'slot'} a ${e.end?.dateTime || e.end?.date || ''}`).join('\\n')\n  : '- Comparteme tus horarios preferidos y te propongo opciones';\n\nconst emailBody = `${lead.email_body}\\n\\nOpciones de agenda (aprox):\\n${slots}`;\nconst dmBody = `${lead.linkedin_dm}\\n\\nSi te sirve, puedo proponerte estos horarios:\\n${slots}`;\n\nreturn [{ json: { ...lead, proposed_slots: slots, email_body_final: emailBody, linkedin_dm_final: dmBody } }];"
      },
