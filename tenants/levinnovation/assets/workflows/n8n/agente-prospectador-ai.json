              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"{{$env.OPENROUTER_MODEL || 'openai/gpt-4o-mini'}}\",\"messages\":[{\"role\":\"system\",\"content\":\"Eres el sistema de calificacion y personalizacion comercial de LEV Innovation. Devuelve solo JSON con fit_score, qualification, email_subject, email_body, linkedin_dm, internal_summary.\"},{\"role\":\"user\",\"content\":\"Lead: {{JSON.stringify($('Split In Batches').item.json)}}\\nKB: {{JSON.stringify($json)}}\\nThreshold: {{$env.LEAD_FIT_THRESHOLD || 70}}\"}],\"temperature\":0.2}",
        "options": {}
      },
      "id": "openrouter",
      "name": "OpenRouter Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1960,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst text = raw.choices?.[0]?.message?.content || '{}';\nlet parsed;\n\ntry {\n  parsed = JSON.parse(text);\n} catch (error) {\n  parsed = {\n    fit_score: 0,\n    qualification: 'No se pudo parsear salida del modelo.',\n    email_subject: 'LEV Innovation - propuesta de automatizacion',\n    email_body: 'Hola, gracias por tu tiempo. Me gustaria compartir ideas de automatizacion aplicables a tu equipo.',\n    linkedin_dm: 'Hola, vi tu perfil y creo que podriamos aportar valor con automatizacion AI aplicada.',\n    internal_summary: 'Salida invalida del modelo; se aplico fallback.'\n  };\n}\n\nconst lead = $('Split In Batches').item.json;\nreturn [{\n  json: {\n    ...lead,\n    fit_score: Number(parsed.fit_score || 0),\n    qualification: String(parsed.qualification || ''),\n    email_subject: String(parsed.email_subject || ''),\n    email_body: String(parsed.email_body || ''),\n    linkedin_dm: String(parsed.linkedin_dm || ''),\n    internal_summary: String(parsed.internal_summary || '')\n  }\n}];"
      },
      "id": "parse-llm",
      "name": "Parse Qualification JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        320
      ]
