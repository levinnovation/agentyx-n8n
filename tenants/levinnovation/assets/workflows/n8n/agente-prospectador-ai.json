    {
      "parameters": {
        "jsCode": "const kb = {\n  tenant: 'levinnovation',\n  source: 'https://www.linkedin.com/company/levinnovation/',\n  content: `LEV Innovation helps organizations deploy practical AI automation for growth, operations, and customer experience.\\n\\nCore services:\\n1) Sales automation and lead qualification workflows\\n2) Customer support copilots and agentic orchestration\\n3) Integration-first business process automation\\n4) AI adoption strategy and implementation support\\n\\nICP:\\n- SMB and mid-market organizations in LATAM\\n- Teams with repetitive workflows and measurable efficiency goals\\n- Decision makers in operations, sales, and customer success\\n\\nDifferentiators:\\n- Deterministic AI workflow orchestration\\n- Human-in-the-loop execution design\\n- Practical implementation focused on business outcomes`\n};\n\nreturn [{ json: kb }];"
      },
      "id": "load-kb",
      "name": "Load LEV Knowledge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        260
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "memoryKey": "lev_kb",
        "text": "={{ $json.content }}"
      },
      "id": "vector-upsert",
      "name": "Simple Vector Store Upsert",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1,
      "position": [
        560,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAPIDAPI_LINKEDIN_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Key",
              "value": "={{ $env.RAPIDAPI_KEY }}"
            },
            {
              "name": "X-RapidAPI-Host",
              "value": "={{ $env.RAPIDAPI_LINKEDIN_HOST }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"query\":\"{{$env.LINKEDIN_SEARCH_QUERY}}\",\"limit\":{{$env.LEADS_PER_RUN || 25}}}",
        "options": {}
      },
      "id": "source-leads",
      "name": "Source LinkedIn Leads (RapidAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst rawLeads = payload.data || payload.results || payload.items || payload.profiles || [];\n\nconst normalized = rawLeads.map((lead, index) => {\n  const fullName = lead.full_name || lead.name || [lead.first_name, lead.last_name].filter(Boolean).join(' ');\n  const company = lead.company_name || lead.company || lead.current_company || '';\n  const role = lead.title || lead.headline || lead.position || '';\n  const email = (lead.email || lead.work_email || '').toLowerCase().trim();\n  const linkedin = lead.profile_url || lead.linkedin_url || lead.url || '';\n  const location = lead.location || lead.geo || '';\n  const summary = lead.summary || lead.about || role;\n\n  return {\n    lead_id: `${index + 1}-${Date.now()}`,\n    full_name: fullName,\n    company,\n    role,\n    email,\n    linkedin_url: linkedin,\n    location,\n    summary,\n    source_payload: lead\n  };\n}).filter((lead) => lead.full_name && (lead.linkedin_url || lead.email));\n\nreturn normalized.map((lead) => ({ json: lead }));"
      },
      "id": "normalize",
      "name": "Normalize Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        260
      ]
    },
