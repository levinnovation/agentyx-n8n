{
  "name": "call-agent-http",
  "id": "call-agent-http",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "call-agent",
        "responseMode": "lastNode"
      },
      "id": "node-0",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "call-agent"
    },
    {
      "parameters": {
        "model": "={{ $json.model || 'openai/gpt-4o-mini' }}",
        "temperature": "={{ $json.temperature || 0.3 }}",
        "maxTokens": "={{ $json.max_tokens || 1024 }}",
        "systemPrompt": "={{ $json.system_prompt || 'You are a helpful AI assistant.' }}",
        "userMessage": "={{ $json.message }}",
        "memoryEnabled": "={{ $json.memory_enabled || false }}",
        "timeout": "={{ $json.timeout || 15000 }}"
      },
      "id": "node-1",
      "name": "AI Agent",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxAIAgentBasicNode",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const agentOutput = $input.all()[0].json;\nreturn {\n  json: {\n    reply_text: agentOutput.reply_text || agentOutput.response || agentOutput.output || '',\n    agent_metadata: agentOutput.metadata || {},\n    tokens_used: agentOutput.tokens_used || 0,\n    model_used: agentOutput.model_used || $json.model || 'unknown',\n    _agent_called_at: new Date().toISOString(),\n  }\n};\n"
      },
      "id": "node-2",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "tags": [],
  "active": false,
  "versionId": null
}