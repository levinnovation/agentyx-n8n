{
  "name": "demo-agentyx-nodes",
  "id": "demo-agentyx-nodes",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-agentyx-nodes",
        "responseMode": "responseNode"
      },
      "id": "node-0",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "demo-agentyx-nodes"
    },
    {
      "parameters": {
        "channel": "generic",
        "payload": "={{ JSON.stringify($json) }}",
        "coreWorkflowId": "demo-agentyx-nodes"
      },
      "id": "node-1",
      "name": "Channel Input",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxChannelFormattedInputNode",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-4o-mini",
        "temperature": 0.3,
        "maxTokens": 1024,
        "systemPrompt": "You are a helpful AI assistant for a demo. Be concise and friendly.",
        "userMessage": "={{ $json.message }}",
        "memoryEnabled": false,
        "timeout": 15000
      },
      "id": "node-2",
      "name": "AI Agent",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxAIAgentBasicNode",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "channel": "generic",
        "replyText": "={{ $json.reply_text }}",
        "recipientId": "={{ $json.user_id }}",
        "sendMethod": "payload"
      },
      "id": "node-3",
      "name": "Channel Output",
      "type": "@levinnovation/n8n-nodes-agentyx.agentyxChannelFormattedOutputNode",
      "typeVersion": 1,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"reply\": $json.reply_text, \"channel\": $json.channel, \"user\": $json.user_id }"
      },
      "id": "node-4",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1040,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Channel Input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Input": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Channel Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Output": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    "demo",
    "agentyx-nodes",
    "ai-agent"
  ],
  "active": false,
  "versionId": null
}