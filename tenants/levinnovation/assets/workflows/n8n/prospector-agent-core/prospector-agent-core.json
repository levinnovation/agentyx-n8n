      "parameters": {
        "jsCode": "\nconst lead = $('Capture Opportunity Result').first().json;\nconst events = $input.all().map(i => i.json).filter(e => e && (e.start || e.id));\nconst busySlots = events.slice(0, 5).map(e => {\n  const s = e.start?.dateTime || e.start?.date || '';\n  const en = e.end?.dateTime || e.end?.date || '';\n  return s ? `- Busy: ${s} -> ${en}` : null;\n}).filter(Boolean);\nconst slotsText = busySlots.length\n  ? `Disponibilidad referencial (proximos 7 dias - excluyendo bloques ocupados):\\n${busySlots.join('\\n')}\\nPropongo coordinar un slot abierto a tu conveniencia.`\n  : 'Tengo disponibilidad esta semana. Proponme 2 horarios y confirmo.';\n\nconst meetingScheduler = $env.MEETING_SCHEDULER_URL || 'https://calendar.google.com';\n\nconst emailBodyFinal = `${lead.email_body}\\n\\n${slotsText}\\n\\nSi prefieres, agenda directamente: ${meetingScheduler}\\n\\n\u2014 Equipo LEV Innovation`;\nconst dmFinal = `${lead.linkedin_dm}\\n\\n${slotsText}\\n\\nAgenda: ${meetingScheduler}`;\n\nreturn [{ json: { ...lead, proposed_slots: slotsText, email_body_final: emailBodyFinal, linkedin_dm_final: dmFinal, meeting_scheduler_url: meetingScheduler } }];\n"
      }
    },
