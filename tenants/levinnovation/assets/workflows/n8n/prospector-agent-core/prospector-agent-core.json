    {
      "id": "compose-agent",
      "name": "Compose Agent Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        400
      ],
      "parameters": {
        "jsCode": "\nconst lead = $('Split In Batches').item.json;\nconst scrape = $input.first().json || {};\nconst tavilyAnswer = scrape.answer || '';\nconst tavilySnippets = Array.isArray(scrape.results)\n  ? scrape.results.slice(0, 3).map(r => `- ${r.title}: ${r.content?.slice(0, 300) || ''}`).join('\\n')\n  : '';\n\nconst kb = `LEV Innovation - ICP & Differentiators\n- ICP: SMB and mid-market organizations in LATAM with measurable efficiency goals\n- Decision makers in operations, sales, customer success\n- Use cases: AI sales automation, customer support copilots, deterministic AI workflow orchestration\n- Differentiators: integration-first, human-in-the-loop, business-outcome focused`;\n\nconst chatInput = [\n  'LEAD (datos normalizados):',\n  JSON.stringify(lead, null, 2),\n  '',\n  'CONTEXTO DE EMPRESA (Tavily web search):',\n  tavilyAnswer ? `Resumen: ${tavilyAnswer}` : '(sin resumen)',\n  tavilySnippets || '(sin snippets)',\n  '',\n  'KNOWLEDGE BASE LEV:',\n  kb,\n  '',\n  `Umbral minimo de fit_score: ${lead.fit_threshold || 70}`,\n  '',\n  'Devuelve SOLO el JSON final sin markdown, sin texto antes ni despues.',\n].join('\\n');\n\nreturn [{ json: { ...lead, _chatInput: chatInput, _tavily_answer: tavilyAnswer } }];\n"
      }
    },
    {
      "id": "agent",
      "name": "Prospector AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        0,
        400
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json._chatInput }}",
        "options": {
          "systemMessage": "Eres el sistema de calificacion y personalizacion comercial de LEV Innovation. Objetivo: (1) Evaluar fit del lead con el ICP LEV. (2) Redactar email y DM iniciales. (3) Emitir SOLO JSON valido para n8n. Reglas: espanol neutral profesional; no inventar datos ausentes; fit_score entero 0-100; qualification max 280 caracteres; email_subject max 90; email_body max 1200; linkedin_dm max 500; internal_summary max 400; sin promesas garantizadas. Forma exacta del JSON: {\"fit_score\":0,\"qualification\":\"\",\"email_subject\":\"\",\"email_body\":\"\",\"linkedin_dm\":\"\",\"internal_summary\":\"\"}."
        }
      }
    },
