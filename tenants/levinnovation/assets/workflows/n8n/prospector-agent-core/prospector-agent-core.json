    {
      "id": "init",
      "name": "Initialize Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2160,
        360
      ],
      "parameters": {
        "jsCode": "\n// Merge inputs from any trigger; unwrap webhook body if present\nconst inputs = $input.all().map(i => i.json || {});\nconst raw = inputs[0] || {};\n// Webhook trigger wraps payload under \"body\"; cron/executeWorkflow pass fields at top\nconst merged = (raw && raw.body && typeof raw.body === 'object') ? { ...raw.body, ...raw } : raw;\nconst env = $env || {};\nconst runConfig = {\n  run_id: `prospect-run-${Date.now()}`,\n  started_at: new Date().toISOString(),\n  linkedin_query: merged.linkedin_query || env.LINKEDIN_SEARCH_QUERY || 'operations manager ai automation latam',\n  leads_per_run: Number(merged.leads_per_run || env.LEADS_PER_RUN || 25),\n  fit_threshold: Number(merged.fit_threshold || env.LEAD_FIT_THRESHOLD || 70),\n  dry_run: Boolean(merged.dry_run),\n  test_leads: Array.isArray(merged.test_leads) ? merged.test_leads : null,\n  tenant: 'levinnovation',\n};\nreturn [{ json: runConfig }];\n"
      }
    },
    {
      "id": "has-test-leads",
      "name": "Has Test Leads?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -1920,
        360
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-has-test-leads",
              "leftValue": "={{ Array.isArray($json.test_leads) && $json.test_leads.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "linkedin-fetch",
      "name": "Source LinkedIn Leads (RapidAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1680,
        480
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAPIDAPI_LINKEDIN_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-RapidAPI-Key",
              "value": "={{ $env.RAPIDAPI_KEY }}"
            },
            {
              "name": "X-RapidAPI-Host",
              "value": "={{ $env.RAPIDAPI_LINKEDIN_HOST }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"query\": \"{{$json.linkedin_query}}\", \"limit\": {{$json.leads_per_run}} }",
        "options": {
          "timeout": 30000
        },
        "alwaysOutputData": true
      },
      "continueOnFail": true
    },
    {
      "id": "normalize",
      "name": "Normalize Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1440,
        360
      ],
      "parameters": {
        "jsCode": "\nconst cfg = $('Initialize Run').first().json;\nlet rawLeads = [];\n\nif (Array.isArray(cfg.test_leads) && cfg.test_leads.length > 0) {\n  rawLeads = cfg.test_leads;\n} else {\n  const payload = $input.first().json || {};\n  rawLeads = payload.data || payload.results || payload.items || payload.profiles || [];\n}\n\nconst normalized = (Array.isArray(rawLeads) ? rawLeads : []).map((lead, index) => {\n  const fullName = lead.full_name || lead.name || [lead.first_name, lead.last_name].filter(Boolean).join(' ');\n  const company = lead.company_name || lead.company || lead.current_company || '';\n  const role = lead.title || lead.headline || lead.position || '';\n  const email = String(lead.email || lead.work_email || '').toLowerCase().trim();\n  const linkedin = lead.profile_url || lead.linkedin_url || lead.url || '';\n  const location = lead.location || lead.geo || '';\n  const companyWebsite = lead.company_website || lead.website || '';\n  const summary = lead.summary || lead.about || role;\n  return {\n    run_id: cfg.run_id,\n    lead_id: `${cfg.run_id}-${index + 1}`,\n    full_name: fullName,\n    company,\n    role,\n    email,\n    linkedin_url: linkedin,\n    company_website: companyWebsite,\n    location,\n    summary,\n    fit_threshold: cfg.fit_threshold,\n    dry_run: cfg.dry_run,\n    source_payload: lead,\n  };\n}).filter((l) => l.full_name && (l.linkedin_url || l.email));\n\n// On empty: emit zero items so downstream branches don't fire on placeholder data\nreturn normalized.map((lead) => ({ json: lead }));\n"
      }
    },
