    {
      "id": "parse-qual",
      "name": "Parse Qualification JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "jsCode": "\nconst raw = $input.first().json || {};\nconst lead = $('Compose Agent Input').item.json;\n\nfunction parseOutput(out) {\n  if (out && typeof out === 'object' && !Array.isArray(out) && out.fit_score !== undefined) {\n    return out;\n  }\n  let text = typeof out === 'string' ? out.trim() : JSON.stringify(out || {});\n  if (text.startsWith('```')) {\n    text = text.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\n  }\n  const firstBrace = text.indexOf('{');\n  const lastBrace = text.lastIndexOf('}');\n  if (firstBrace >= 0 && lastBrace > firstBrace) {\n    text = text.slice(firstBrace, lastBrace + 1);\n  }\n  return JSON.parse(text);\n}\n\nlet parsed;\nlet parseError = null;\ntry {\n  parsed = parseOutput(raw.output ?? raw.text ?? raw);\n} catch (e) {\n  parseError = String(e);\n  parsed = {\n    fit_score: 0,\n    qualification: 'No se pudo parsear salida del agente.',\n    email_subject: 'LEV Innovation - propuesta de automatizacion',\n    email_body: 'Hola, gracias por tu tiempo. Me gustaria compartir ideas de automatizacion aplicables a tu equipo.',\n    linkedin_dm: 'Hola, vi tu perfil y creo que podriamos aportar valor con automatizacion AI aplicada.',\n    internal_summary: 'Salida invalida del agente; se aplico fallback.',\n  };\n}\n\nreturn [{\n  json: {\n    ...lead,\n    fit_score: Number(parsed.fit_score || 0),\n    qualification: String(parsed.qualification || ''),\n    email_subject: String(parsed.email_subject || ''),\n    email_body: String(parsed.email_body || ''),\n    linkedin_dm: String(parsed.linkedin_dm || ''),\n    internal_summary: String(parsed.internal_summary || ''),\n    _parse_error: parseError,\n  }\n}];\n"
      }
    },
