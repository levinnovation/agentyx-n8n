# Meetings Agent Core (Levinnovation)

# OpenRouter credential is stored in n8n; model can be overridden in the workflow UI.
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Composio MCP proxy.
COMPOSIO_MCP_URL=https://levinnovation.mcp.agentyx.one/mcp
COMPOSIO_ENTITY_ID=levinnovation-meetings
MCP_AUTH_TOKEN=REQUIRED_SET_IN_N8N_MULTIPLE_HEADERS_CREDENTIAL

# Optional external meeting joiner/transcription layer.
# The n8n workflow expects transcript_text once the joiner has finished.
MEETING_JOINER_API_URL=
MEETING_JOINER_API_KEY=

# Default behavior flags.
MEETINGS_EXTERNAL_ACTIONS_ENABLED=false
MEETINGS_SEND_FOLLOWUP_EMAIL=false
MEETINGS_CREATE_CLICKUP_TASKS=false
MEETINGS_SCHEDULE_FOLLOWUPS=false
MEETINGS_DEFAULT_TIMEZONE=America/Costa_Rica
MEETINGS_DEFAULT_LANGUAGE=es-CR
