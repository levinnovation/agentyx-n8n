      "id": "meetings-core-normalize-envelope",
      "name": "Normalize Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -160,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\nconst transcript = String(item.transcript_text || '').trim();\nconst message = String(item.message || '').trim();\nconst meetingUrl = String(item.meeting_url || '').trim();\nconst turns = transcript.split(/\\n+/).map(s => s.trim()).filter(Boolean);\nconst looksLikeMeeting = turns.length >= 5 && /(:|speaker|hablante|vinicio|lev|meeting|reunion|reunión|acuerdo|tarea|decision|decisión)/i.test(transcript);\nlet request_type = 'conversation';\nlet status_hint = 'pending';\nif (transcript && looksLikeMeeting) {\n  request_type = 'transcript_processing';\n  status_hint = 'ready';\n} else if (meetingUrl) {\n  request_type = 'meeting_url_pending_transcript';\n  status_hint = 'pending';\n} else if (transcript) {\n  request_type = 'invalid_transcript';\n  status_hint = 'skipped';\n}\nconst language = /[áéíóúñ¿¡]|\\b(hola|reunion|reunión|tarea|acuerdo|correo)\\b/i.test(message + ' ' + transcript) ? 'es-CR' : 'en';\nreturn [{ json: { ...item, request_type, status_hint, language, transcript_turn_count: turns.length, transcript_valid: request_type === 'transcript_processing' } }];"
      },
      "id": "meetings-core-classify-request",
      "name": "Classify Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ Boolean($json.transcript_valid) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "meetings-core-transcript-valid",
      "name": "Transcript Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        320,
        120
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Request type: ' + $json.request_type + '\\nStatus hint: ' + $json.status_hint + '\\nLanguage: ' + $json.language + '\\nMeeting URL: ' + ($json.meeting_url || '') + '\\nMeeting title: ' + ($json.meeting_title || '') + '\\nMeeting date: ' + ($json.meeting_date || '') + '\\nMessage: ' + ($json.message || '') + '\\nTranscript turns: ' + ($json.transcript_turn_count || 0) }}",
        "options": {
          "systemMessage": "You are Sofer Intake Agent for LEV Innovation. Classify setup and non-ready meeting requests. Same language as user. If meeting_url is present but transcript_text is missing, return JSON status pending and explain a meeting-joiner/transcription service must provide transcript first. If transcript is invalid or shorter than five turns, return status skipped. If conversational, answer briefly as Sofer. Never claim attendance without transcript or bot result. Return valid JSON only with keys: status, language, meeting, errors, user_message."
        }
      },
      "id": "meetings-core-intake-agent",
      "name": "AI Agent (Intake + Validation)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Meeting ID: ' + $json.meeting_id + '\\nMeeting title: ' + $json.meeting_title + '\\nMeeting date: ' + $json.meeting_date + '\\nMeeting URL: ' + ($json.meeting_url || '') + '\\nKnown attendees hint: ' + (Array.isArray($json.attendees_hint) ? JSON.stringify($json.attendees_hint) : '[]') + '\\nLanguage: ' + $json.language + '\\n\\n--- TRANSCRIPT ---\\n' + ($json.transcript_text || '') + '\\n--- END TRANSCRIPT ---' }}",
        "options": {
          "systemMessage": "You are Sofer Transcript Extraction Agent for LEV Innovation. Extract structured meeting intelligence from a valid transcript. Default deliverable language is Spanish Costa Rica unless requested otherwise. Never invent facts, dates, owners, deadlines, attendees, or decisions. Resolve relative dates from meeting_date in America/Costa_Rica. If identity is uncertain use TBD - speaker label. Flag risks for unclear owners, unresolved dependencies, doubt, disagreement, or implied follow-up. Return valid JSON only with: status, language, meeting, attendee_candidates, executive_summary, decisions, action_items, risks_and_questions, errors."
        }
      },
      "id": "meetings-core-extraction-agent",
      "name": "AI Agent (Transcript Extraction)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        560,
        20
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst rawOutput = raw.output || raw.text || raw.message || raw;\nlet parsed = null;\nif (typeof rawOutput === 'string') {\n  const match = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (match) { try { parsed = JSON.parse(match[0]); } catch (e) { parsed = null; } }\n} else if (typeof rawOutput === 'object') parsed = rawOutput;\nconst input = $('Classify Request').item.json || {};\nconst safe = parsed || {};\nreturn [{ json: { ...input, extraction: safe, raw_extraction_output: rawOutput } }];"
      },
      "id": "meetings-core-parse-extraction",
      "name": "Parse Extraction JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        20
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Input envelope:\\n' + JSON.stringify($json, null, 2) }}",
        "options": {
          "systemMessage": "You are Sofer Artifact Composer Agent. Transform extracted meeting intelligence into operational artifacts. Do not call tools. Create Google Doc markdown, follow-up email subject/body, ClickUp task payloads, and follow-up calendar proposals. Do not fabricate IDs, URLs, task IDs, email IDs, or calendar IDs. Return valid JSON only with: status, language, meeting, google_doc_markdown, email_draft, clickup_tasks, calendar_proposals, executive_summary, decisions, action_items, risks_and_questions, errors."
        }
      },
      "id": "meetings-core-artifact-agent",
      "name": "AI Agent (Artifact Composer)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
