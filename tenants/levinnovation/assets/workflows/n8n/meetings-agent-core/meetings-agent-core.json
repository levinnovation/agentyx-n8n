    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'External action payload:\\n' + JSON.stringify($json, null, 2) }}",
        "options": {
          "systemMessage": "You are Sofer Actions Agent for LEV Innovation. Use Composio MCP tools only when external actions are enabled and enough data exists. Strict order: 1 calendar lookup near meeting_date +/- 4h to map attendees, 2 create Google Doc and insert prepared notes, 3 send Gmail follow-up only to confirmed emails when send_followup_email is true, 4 create ClickUp tasks when create_clickup_tasks is true and clickup_list_id exists, 5 schedule follow-up meetings only when schedule_followups is true and conflict-free. Never email uncertain recipients. Never overwrite calendar conflicts. Return valid JSON only with status, created_artifacts, matched_attendees, missing_attendees, pending_meetings, errors, user_message."
        }
      },
      "id": "meetings-core-actions-agent",
      "name": "AI Agent (MCP Actions)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        1980,
        -80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst rawOutput = raw.output || raw.text || raw.message || raw;\nlet parsed = null;\nif (typeof rawOutput === 'string') {\n  const match = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  if (match) { try { parsed = JSON.parse(match[0]); } catch (e) { parsed = null; } }\n} else if (typeof rawOutput === 'object') parsed = rawOutput;\nlet base = {};\ntry { base = $('Parse Artifacts JSON').item.json || {}; } catch (e) { try { base = $('Classify Request').item.json || {}; } catch (e2) { base = {}; } }\nconst artifacts = base.artifacts || {};\nconst actions = parsed || {};\nconst created = actions.created_artifacts || artifacts.created_artifacts || { google_doc_url: null, sent_email_ids: [], clickup_task_ids: [], calendar_event_ids: [] };\nconst errors = []\n  .concat(Array.isArray(base.errors) ? base.errors : [])\n  .concat(Array.isArray((base.extraction || {}).errors) ? base.extraction.errors : [])\n  .concat(Array.isArray(artifacts.errors) ? artifacts.errors : [])\n  .concat(Array.isArray(actions.errors) ? actions.errors : []);\nconst status = actions.status || artifacts.status || (base.extraction || {}).status || base.status_hint || 'completed';\nreturn [{ json: {\n  status,\n  language: actions.language || artifacts.language || (base.extraction || {}).language || base.language || 'es-CR',\n  meeting: actions.meeting || artifacts.meeting || (base.extraction || {}).meeting || { title: base.meeting_title, meeting_url: base.meeting_url, meeting_date: base.meeting_date, duration_minutes: null, attendees: [] },\n  executive_summary: artifacts.executive_summary || (base.extraction || {}).executive_summary || [],\n  decisions: artifacts.decisions || (base.extraction || {}).decisions || [],\n  action_items: artifacts.action_items || (base.extraction || {}).action_items || [],\n  risks_and_questions: artifacts.risks_and_questions || (base.extraction || {}).risks_and_questions || [],\n  created_artifacts: created,\n  errors,\n  user_message: actions.user_message || artifacts.user_message || (base.extraction || {}).user_message || raw.user_message || '',\n  raw_outputs: { intake_or_actions: rawOutput, extraction: base.raw_extraction_output || null, artifacts: base.raw_artifact_output || null }\n} }];"
      },
