        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "9a9e0242-95db-4a28-b1fa-713b44d3c32c",
      "name": "Merge Template Context1",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        4336,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = String(item.message || '').trim();\nconst lower = raw.toLowerCase();\n\nconst isSlackIntent = /\\bslack\\b/.test(lower) && /(envi|manda|mandar|post|send|mensaje|message|avisa|notifica)/.test(lower);\nconst isGmailIntent = /\\b(gmail|email|correo|e-mail|enviar mail|send mail|send an email|send email)\\b/.test(lower);\nconst isCalendarIntent = /(calendar|calendario|evento|eventos|meeting|reunion)/.test(lower);\n\nlet targetHint = '';\nlet actionMessage = '';\nlet emailRecipient = '';\nlet emailSubject = '';\nlet emailBody = '';\n\n// Extract quoted text\nconst quoted = raw.match(/[\"\\u201C\\u201D'\"]([^\"\\u201C\\u201D'\"]{3,})[\"\\u201C\\u201D'\"]/u);\nif (quoted) actionMessage = quoted[1].trim();\n\n// Slack target extraction\nconst targetMatch = raw.match(/(?:a|to)\\s+([A-Za-z\\u00C0-\\u00FF0-9._@\\-\\s]{2,60}?)(?:\\s+(?:que\\s+diga|diga|saying\\s+that|that)|\\s*:|\\$)/i);\nif (targetMatch) targetHint = targetMatch[1].trim();\n\nif (!actionMessage) {\n  const sayMatch = raw.match(/(?:que\\s+diga|diga|saying\\s+that|saying)\\s+(.+)\\$/i);\n  if (sayMatch) actionMessage = sayMatch[1].trim();\n}\n\nif (!actionMessage && isSlackIntent) actionMessage = raw;\n\n// Email field extraction (structured text from user)\nconst recipientMatch = raw.match(/(?:recipient|to|para|destinatario)[\\s:]*([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})/i);\nif (recipientMatch) emailRecipient = recipientMatch[1].trim().toLowerCase();\n\nconst subjectMatch = raw.match(/(?:subject|asunto|tema)[\\s:]*(.{2,200}?)(?:\\n|\\$|email body|body|mensaje|contenido)/i);\nif (subjectMatch) emailSubject = subjectMatch[1].trim();\n\nconst bodyMatch = raw.match(/(?:email body|body|mensaje|contenido)[\\s:]*(.{2,2000})/i);\nif (bodyMatch) emailBody = bodyMatch[1].trim();\n\n// Fallback: if structured fields missing but email intent detected, try to find raw email\nif (isGmailIntent && !emailRecipient) {\n  const rawEmail = raw.match(/([A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,})/i);\n  if (rawEmail) emailRecipient = rawEmail[1].trim().toLowerCase();\n}\n\nlet intentType = 'general_chat';\nif (isSlackIntent) intentType = 'slack_send_action';\nelse if (isGmailIntent) intentType = 'gmail_send_action';\nelse if (/(clickup|tarea|task|asignad|assigned)/.test(lower)) intentType = 'clickup_lookup';\nelse if (isCalendarIntent) intentType = 'calendar_lookup';\n\n// Pre-compute email template section for AI prompt\nconst html = item.html || '';\nconst emailTemplateSection = intentType === 'gmail_send_action' && html\n  ? '\\n\\n[EMAIL_TEMPLATE_HTML]\\n' + html.slice(0, 6000) + '\\n\\n[EMAIL_TEMPLATE_RULE]\\nIf you call Gmail send, convert markdown body to valid HTML, inject it into template placeholder body_html, and pass the resulting HTML body with is_html=true.'\n  : '';\n\nreturn [{ json: { \n  ...item, \n  intent_type: intentType, \n  action_target_hint: targetHint, \n  action_message: actionMessage,\n  email_recipient: emailRecipient,\n  email_subject: emailSubject,\n  email_body: emailBody,\n  email_template_section: emailTemplateSection\n} }];\n"
      },
      "id": "113f7edd-59ba-42e9-8dce-da0d4bf04207",
      "name": "Intent Preprocessor1",
