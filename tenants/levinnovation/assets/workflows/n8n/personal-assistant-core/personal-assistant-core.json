    {
      "parameters": {
        "jsCode": "const item = $input.first(); return [{ json: { ...(item.json || {}), template_intercept_applied: false } }];"
      },
      "id": "866265c3-e54f-4139-8ba2-66a3e61853c2",
      "name": "Skip Template Intercept1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4512,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst data = item.json || {};\nconst templateHtml = String(data.email_template_html || data.html || \"\").trim();\nconst markdownCandidate = String(data.generated_email_markdown || data.message || data.enriched_message || \"\").trim();\nconst fallbackBody = markdownCandidate\n  ? `<p style=\"margin:0 0 12px 0;\">${markdownCandidate.replace(/\\n/g, \"<br />\")}</p>`\n  : `<p style=\"margin:0;\">No body content provided.</p>`;\nconst htmlBody = templateHtml && templateHtml.includes(\"{{body_html}}\")\n  ? templateHtml.replace(/\\{\\{body_html\\}\\}/g, fallbackBody)\n  : fallbackBody;\nreturn [{ json: { ...data, template_intercept_applied: true, intercepted_email_html: htmlBody, composio_email_payload: { body: htmlBody, is_html: true } } }];"
      },
      "id": "59677265-829c-4b8b-a8e6-958778e585a6",
      "name": "Apply Template Intercept1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4608,
        -16
      ]
    },
    {
