RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data.p.rapidapi.com
RAPIDAPI_KEY=

# ---------- Lead qualification ----------
LEAD_FIT_THRESHOLD=70
LEADS_PER_RUN=25
LINKEDIN_SEARCH_QUERY=operations manager ai automation latam

# ---------- Twenty CRM ----------
TWENTY_API_KEY=

# ---------- Slack notifications ----------
SLACK_WEBHOOK_URL=
