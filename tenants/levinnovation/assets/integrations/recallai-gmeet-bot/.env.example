# Recall.ai Google Meet Bot (Sofer) — Environment Template
# Copy to .env and fill in actual values. NEVER commit .env to Git.

# === Recall.ai API ===
RECALL_API_KEY=REQUIRED
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1

# === Google Meet Login Group ===
# ID from Recall.ai dashboard or POST /api/v2/google-login-groups/
RECALL_GOOGLE_LOGIN_GROUP_ID=

# === Webhook Verification ===
# Recall.ai webhook signing secret (for HMAC validation of incoming webhooks)
RECALL_WEBHOOK_SECRET=

# === n8n / Upstream Integration ===
# URL of the meetings-agent-core Execute Workflow Trigger
# The recallai orchestrator POSTs transcript here when ready
MEETINGS_AGENT_CORE_URL=https://levinnovation.n8n.agentyx.one/webhook/sofer-transcript

# === Google Workspace SSO (only if using signed-in bots) ===
# These are PEM contents, not file paths. Store in Railway/n8n secrets.
# RECALL_GOOGLE_SSO_PRIVATE_KEY=
# RECALL_GOOGLE_SSO_CERT=
# RECALL_GOOGLE_SSO_DOMAIN=
# RECALL_GOOGLE_BOT_EMAIL=

# === Bot Defaults ===
RECALL_BOT_NAME=Sofer
RECALL_DEFAULT_LANGUAGE=en-US
RECALL_TRANSCRIPTION_PROVIDER=default
