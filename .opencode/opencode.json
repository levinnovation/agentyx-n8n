{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "type": "local",
      "command": ["railway", "run"],
      "enabled": true,
      "description": "Railway CLI integration for managing deployments",
      "environment": {
        "RAILWAY_TOKEN": "${RAILWAY_TOKEN}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "description": "Search through documentation"
    }
  },
  "tools": {
    "skill": true
  },
  "agent": {
    "general": {
      "tools": {
        "railway_*": true,
        "context7_*": true,
        "skill": true
      }
    }
  }
}
