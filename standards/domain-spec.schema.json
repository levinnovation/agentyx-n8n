{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/domain-spec.json",
  "title": "Domain Spec",
  "type": "object",
  "required": ["id", "name", "tenant", "capabilities"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "tenant": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "data_residency": { "type": "string" },
    "compliance": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
