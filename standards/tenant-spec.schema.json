{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/tenant-spec.json",
  "title": "Tenant Spec",
  "type": "object",
  "required": ["id", "name", "version", "domains"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "contact": { "type": "string", "format": "email" },
    "domains": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
