{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/capability-spec.json",
  "title": "Capability Spec",
  "type": "object",
  "required": ["id", "name", "tenant", "domain", "purpose", "assets", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "tenant": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "purpose": { "type": "string" },
    "assets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": ["scaffolded", "validated", "compiled", "deployed", "monitored", "deprecated", "retired"]
    },
    "sla": {
      "type": "object",
      "properties": {
        "response_time_ms": { "type": "integer" },
        "availability": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
