{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/channel-asset.json",
  "title": "Channel Asset Spec",
  "type": "object",
  "required": ["id", "name", "channel_type", "direction"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "channel_type": {
      "type": "string",
      "enum": ["whatsapp", "sms", "email", "web", "api", "slack", "teams"]
    },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound", "bidirectional"]
    },
    "provider": { "type": "string" },
    "webhook_url": { "type": "string", "format": "uri" },
    "credentials_env_prefix": { "type": "string" }
  }
}
