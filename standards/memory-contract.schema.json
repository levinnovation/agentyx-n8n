{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/memory-contract.json",
  "title": "Memory Contract Spec",
  "type": "object",
  "required": ["id", "name", "memory_type", "scope"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "memory_type": {
      "type": "string",
      "enum": ["short_term", "long_term", "episodic", "semantic", "procedural"]
    },
    "scope": {
      "type": "string",
      "enum": ["session", "user", "tenant", "global"]
    },
    "backend": { "type": "string", "enum": ["supabase", "redis", "postgres", "sqlite", "vector"] },
    "ttl_seconds": { "type": "integer" }
  }
}
