{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/compiler-deployment.json",
  "title": "Compiler Deployment Receipt",
  "type": "object",
  "required": ["receiptId", "tenant", "deployedAt", "status"],
  "properties": {
    "receiptId": { "type": "string", "format": "uuid" },
    "tenant": { "type": "string" },
    "environment": { "type": "string", "enum": ["dev", "prod"] },
    "deployedAt": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "commitHash": { "type": "string" },
    "author": { "type": "string" },
    "agentSkill": { "type": "string" },
    "cliVersion": { "type": "string" },
    "n8nVersion": { "type": "string" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "objectType", "objectName"],
        "properties": {
          "action": { "type": "string", "enum": ["CREATE", "UPDATE", "DELETE", "ACTIVATE", "DEACTIVATE"] },
          "objectType": { "type": "string" },
          "objectName": { "type": "string" },
          "objectId": { "type": "string" },
          "previousValueHash": { "type": "string" },
          "newValueHash": { "type": "string" },
          "auditId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objectName": { "type": "string" },
          "message": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    }
  }
}
