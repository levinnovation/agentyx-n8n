{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentyx.io/schemas/credential-spec.json",
  "title": "N8n Credential Spec",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["agentyx.io/v1"]
    },
    "kind": {
      "type": "string",
      "enum": ["N8nCredential"]
    },
    "metadata": {
      "type": "object",
      "required": ["name", "tenant"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "tenant": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "domain": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "capability": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "owner": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "description": "n8n credential type ID" },
        "description": { "type": "string" },
        "data": {
          "type": "object",
          "description": "Credential fields. Values may be vault references like ${VAULT::...}"
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
