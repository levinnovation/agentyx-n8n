# Caddy auth proxy for Agentyx tenant stack
# Railway terminates TLS at the edge — auto-HTTPS must be off.

{
  auto_https off
}

# Health check endpoint for Railway
:80 {
  handle /health {
    respond "OK" 200
  }
  handle {
    respond "Auth Proxy" 200
  }
}

http://demo.n8n.agentyx.one {
  @n8n_webhooks path /webhook /webhook/* /form /form/* /rest/oauth2-credential/callback /rest/oauth1-credential/callback
  @n8n_test_webhooks path /webhook-test /webhook-test/* /webhook-waiting /webhook-waiting/*

  handle @n8n_webhooks {
    reverse_proxy agx-demo-n8n-webhook.railway.internal:5678 {
      header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
    }
  }

  handle @n8n_test_webhooks {
    reverse_proxy agx-demo-n8n.railway.internal:5678 {
      header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
    }
  }

  handle {
    forward_auth agx-demo-better-auth.railway.internal:3000 {
      uri /api/auth/forward-auth
      copy_headers X-Auth-User X-Auth-Email
    }
    reverse_proxy agx-demo-n8n.railway.internal:5678 {
      header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
    }
  }
}

http://demo.flowise.agentyx.one {
  forward_auth agx-demo-better-auth.railway.internal:3000 {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy agx-demo-flowise.railway.internal:3000 {
    header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
  }
}

http://demo.paperclip.agentyx.one {
  forward_auth agx-demo-better-auth.railway.internal:3000 {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email X-Auth-User-Name X-Auth-User-Role
  }
  reverse_proxy agx-demo-paperclip.railway.internal:3100 {
    header_up X-Auth-User-Id {http.request.header.X-Auth-User}
    header_up X-Auth-User-Email {http.request.header.X-Auth-Email}
    header_up X-Auth-User-Name {http.request.header.X-Auth-User-Name}
    header_up X-Auth-User-Role {http.request.header.X-Auth-User-Role}
    header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
  }
}

http://demo.chat.agentyx.one {
  forward_auth agx-demo-better-auth.railway.internal:3000 {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy agx-demo-librechat.railway.internal:3080 {
    header_up X-Auth-Proxy-Secret __TRUSTED_PROXY_SECRET__
  }
}
