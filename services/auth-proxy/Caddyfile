# Caddy auth proxy for Agentyx tenant stack
# Railway terminates TLS at the edge — auto-HTTPS must be off.

{
  auto_https off
}

# Health check endpoint for Railway
:80 {
  handle /health {
    respond "OK" 200
  }
  handle /debug {
    respond "host={http.request.host} env_n8n={env.N8N_PUBLIC_HOST}" 200
  }
  handle {
    respond "Auth Proxy" 200
  }
}

{$N8N_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$N8N_INTERNAL_URL}
}

{$FLOWISE_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$FLOWISE_INTERNAL_URL}
}

{$PAPERCLIP_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$PAPERCLIP_INTERNAL_URL}
}

{$LIBRECHAT_PUBLIC_HOST} {
  forward_auth {$BETTER_AUTH_INTERNAL_URL} {
    uri /api/auth/forward-auth
    copy_headers X-Auth-User X-Auth-Email
  }
  reverse_proxy {$LIBRECHAT_INTERNAL_URL}
}
