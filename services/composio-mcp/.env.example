# Composio MCP bridge (Railway)
#
# Copy to Railway Variables for service `agx-demo-composio-mcp` (or equivalent).
# NEVER commit real secrets.

# Required: Composio project API key from https://app.composio.dev
COMPOSIO_API_KEY=

# Required: shared secret for n8n MCP Client Tool (Bearer token)
MCP_AUTH_TOKEN=

# Base URL for Composio REST API (default: v3.1)
COMPOSIO_API_BASE=https://backend.composio.dev/api/v3.1

# Recommended: Composio user / entity id for tool execution (maps to request body user_id)
COMPOSIO_ENTITY_ID=

# Optional fallback: connected account id when auto-selection cannot infer best account
# COMPOSIO_CONNECTED_ACCOUNT_ID=

# Request-level headers supported by /mcp:
# - x-entity-id: override user/entity for this request
# - x-connected-account-id: force connected account for this request

# Optional: comma-separated toolkit_slug values to limit discovery (smaller tool list, faster startup)
# COMPOSIO_ALLOWED_TOOLKITS=

# Optional: comma-separated tool slugs to allow list+call (strongest control)
# COMPOSIO_ALLOWED_ACTIONS=

# ─── Smart Default Curation (prevents token overflow) ─────────────────
# When no explicit allowlists are set, the server automatically curates a diverse
# top-N subset of tools ranked by: connected OAuth accounts, category utility,
# and description quality. Set to 'false' to return all tools (dangerous for LLM context).
COMPOSIO_SMART_DEFAULT=true

# How many tools to return in smart-default mode (1–200)
COMPOSIO_SMART_DEFAULT_COUNT=50

# Optional: default toolkits to include when no explicit allowlist is set
# (fallback if smart default still returns too many)
# COMPOSIO_DEFAULT_TOOLKITS=gmail,slack,google-search,notion

# Caps & tuning
COMPOSIO_TOOLS_MAX=2000
COMPOSIO_TOOLS_PAGE_LIMIT=250
COMPOSIO_TOOLS_MAX_PAGES=200
COMPOSIO_EXCLUDE_DEPRECATED=true
COMPOSIO_HTTP_TIMEOUT_MS=60000
COMPOSIO_HTTP_MAX_RETRIES=3
JSON_BODY_LIMIT=2mb

# Server port (Railway sets PORT automatically)
# PORT=3000
