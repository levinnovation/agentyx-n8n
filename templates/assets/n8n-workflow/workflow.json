{
  "name": "{{asset_name}}",
  "nodes": [
    {
      "id": "trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "{{asset_id}}"
      }
    },
    {
      "id": "respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [450, 300],
      "parameters": {
        "options": {}
      }
    }
  ],
  "connections": {
    "trigger": {
      "main": [[{"node": "respond", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
